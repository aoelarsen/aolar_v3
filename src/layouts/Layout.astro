---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getUi, locales } from '../i18n/ui';
import '../styles/global.css';

export interface Props {
    title: string;
    /** Locale-agnostic page path, e.g. '' for the home page or 'about'. */
    path?: string;
}

const { title, path = '' } = Astro.props;
const locale = Astro.currentLocale === 'en' ? 'en' : 'nb';
const t = getUi(locale);
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width' />
        <link rel='icon' href='/brand/favicon.ico' sizes='48x48' />
        <link rel='icon' type='image/svg+xml' href='/brand/favicon.svg' />
        <link rel='apple-touch-icon' href='/brand/apple-touch-icon.png' />
        <link rel='manifest' href='/site.webmanifest' />
        <meta name='theme-color' content='#f1ede3' media='(prefers-color-scheme: light)' />
        <meta name='theme-color' content='#12201a' media='(prefers-color-scheme: dark)' />
        <meta name='generator' content={Astro.generator} />
        <title>{title}</title>
        {
            locales.map((l) => (
                <link rel='alternate' hreflang={l} href={new URL(getRelativeLocaleUrl(l, path), Astro.site)} />
            ))
        }
        <link rel='alternate' hreflang='x-default' href={new URL(getRelativeLocaleUrl('nb', path), Astro.site)} />
        {
            locale === 'nb' && (
                <script is:inline define:vars={{ enHref: getRelativeLocaleUrl('en', path) }}>
                    // Norwegian is the default. Switch to English only when the visitor
                    // picked it with LanguageSwitcher, or when their browser lists English
                    // before any Norwegian variant. Crawlers stay put so both versions get indexed.
                    (function () {
                        var choice = null;
                        try {
                            choice = localStorage.getItem('aolar-lang');
                        } catch (e) {}
                        var wantsEnglish = false;
                        if (choice === 'en' || choice === 'nb') {
                            wantsEnglish = choice === 'en';
                        } else {
                            var langs = navigator.languages || [navigator.language];
                            for (var i = 0; i < langs.length; i++) {
                                var lang = String(langs[i]).toLowerCase();
                                if (/^(nb|nn|no)(-|$)/.test(lang)) break;
                                if (/^en(-|$)/.test(lang)) {
                                    wantsEnglish = true;
                                    break;
                                }
                            }
                        }
                        if (wantsEnglish && !/bot|crawl|spider/i.test(navigator.userAgent)) {
                            location.replace(enHref + location.search + location.hash);
                        }
                    })();
                </script>
            )
        }
        <script is:inline>
            (function () {
                var theme = localStorage.getItem('aolar-theme');
                if (theme === 'light' || theme === 'dark') {
                    document.documentElement.setAttribute('data-theme', theme);
                }
            })();
        </script>
    </head>
    <body>
        <a href='#main-content' class='skip-link'>{t.skipToContent}</a>
        <div class='front-wrap container'>
            <Header path={path} />
            <slot />
            <Footer />
        </div>
    </body>
</html>
