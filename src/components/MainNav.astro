---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getUi } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

export interface Props {
    path?: string;
}

const { path = '' } = Astro.props;
const locale = Astro.currentLocale === 'nb' ? 'nb' : 'en';
const t = getUi(locale);

const links = [
    { path: '', label: t.nav.home },
    { path: 'about', label: t.nav.about },
    { path: 'contact', label: t.nav.contact },
].map((link) => ({
    ...link,
    href: getRelativeLocaleUrl(locale, link.path),
    isActive: link.path === path,
}));
---

<nav class='site-nav'>
    <div class='nav-inner'>
        <div class='nav-bar'>
            <div class='menu-button-wrap'>
                <button
                    type='button'
                    class='menu-button'
                    aria-controls='mobileMenu'
                    aria-expanded='false'
                    id='navButton'
                >
                    <span class='sr-only'>{t.openMenu}</span>
                    <svg
                        class='icon icon-open'
                        xmlns='http://www.w3.org/2000/svg'
                        fill='none'
                        viewBox='0 0 24 24'
                        stroke-width='1.5'
                        stroke='currentColor'
                        aria-hidden='true'
                    >
                        <path
                            stroke-linecap='round'
                            stroke-linejoin='round'
                            d='M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5'></path>
                    </svg>
                    <svg
                        class='icon icon-closed'
                        xmlns='http://www.w3.org/2000/svg'
                        fill='none'
                        viewBox='0 0 24 24'
                        stroke-width='1.5'
                        stroke='currentColor'
                        aria-hidden='true'
                    >
                        <path stroke-linecap='round' stroke-linejoin='round' d='M6 18L18 6M6 6l12 12'
                        ></path>
                    </svg>
                </button>
            </div>
            <div class='nav-links'>
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            class:list={['nav-link', { 'is-active': link.isActive }]}
                            aria-current={link.isActive ? 'page' : undefined}
                        >
                            {link.label}
                        </a>
                    ))
                }
            </div>
        </div>
    </div>

    <div class='mobile-menu' id='mobileMenu'>
        <div class='mobile-menu-inner'>
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class:list={['nav-link', { 'is-active': link.isActive }]}
                        aria-current={link.isActive ? 'page' : undefined}
                    >
                        {link.label}
                    </a>
                ))
            }
            <div class='mobile-utility-bar'>
                <ThemeToggle />
                <LanguageSwitcher path={path} />
            </div>
        </div>
    </div>
</nav>

<style>
    .site-nav {
        justify-self: end;
        width: 100%;
    }

    .nav-inner {
        max-width: 80rem;
        margin-inline: auto;
        padding-inline: 0.5rem;
    }

    @media (min-width: 640px) {
        .nav-inner {
            padding-inline: 1.5rem;
        }
    }

    @media (min-width: 1024px) {
        .nav-inner {
            padding-inline: 2rem;
        }
    }

    .nav-bar {
        display: flex;
        height: 4rem;
        align-items: center;
        justify-content: space-between;
    }

    .menu-button-wrap {
        display: flex;
        align-items: center;
    }

    @media (min-width: 640px) {
        .menu-button-wrap {
            display: none;
        }
    }

    .menu-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.125rem;
        padding: 0.5rem;
        color: var(--ink);
        background: transparent;
        border: none;
        cursor: pointer;
    }

    .menu-button:hover {
        background-color: var(--ink);
        color: var(--surface);
    }

    .icon {
        height: 1.5rem;
        width: 1.5rem;
    }

    .icon-closed {
        display: none;
    }

    .site-nav.menu-open .icon-open {
        display: none;
    }

    .site-nav.menu-open .icon-closed {
        display: block;
    }

    .nav-links {
        display: none;
    }

    @media (min-width: 640px) {
        .nav-links {
            display: flex;
            gap: 1rem;
            margin-left: 1.5rem;
        }
    }

    .mobile-menu {
        position: relative;
        height: min-content;
        display: none;
    }

    .site-nav.menu-open .mobile-menu {
        display: block;
    }

    @media (min-width: 768px) {
        .mobile-menu {
            display: none !important;
        }
    }

    .mobile-menu-inner {
        position: absolute;
        right: 5vw;
        width: 80vw;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        background-color: var(--surface);
        padding: 0.5rem 0.5rem 0.75rem;
        border-radius: 0.125rem;
        border: 1px solid var(--ink);
    }

    /* Theme/language controls live here on small screens; Header.astro hides
       its own copy below 640px, where this menu is the only way to reach it. */
    .mobile-utility-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.25rem;
        padding-top: 0.5rem;
        border-top: 1px solid var(--ink);
    }

    .nav-link {
        color: var(--ink);
        padding: 0.5rem 0.75rem;
        border-radius: 0.125rem;
        font-size: 0.9375rem;
        font-weight: 700;
        text-decoration: none;
    }

    .nav-link:hover,
    .nav-link:focus-visible {
        color: var(--surface);
        background-color: var(--ink);
    }

    .nav-link.is-active {
        background-color: var(--ink);
        color: var(--surface);
    }
</style>

<script is:inline>
    const navButton = document.getElementById('navButton');
    const nav = navButton.closest('.site-nav');
    navButton.addEventListener('click', () => {
        const isOpen = nav.classList.toggle('menu-open');
        navButton.setAttribute('aria-expanded', String(isOpen));
    });
</script>
