---
import { getUi } from '../i18n/ui';

const t = getUi(Astro.currentLocale);
const thisYear = new Date().getFullYear();
---

<footer class='site-footer'>
    <p class='footer-text'>{t.footer.orgNumberLabel}: {t.footer.orgNumberValue}</p>
    <p class='footer-text'>&copy; {thisYear}<span class='footer-brand'> AOL</span>ar.no</p>
    <a class='footer-login' href='/radgiver' rel='nofollow'>{t.footer.loginLabel}</a>
</footer>

<style>
    .site-footer {
        font-family: var(--font-sans);
        padding: 1rem;
        height: min-content;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        gap: 1.5rem;
    }

    .footer-text {
        margin: 0;
    }

    /* Deliberately quiet: it's only for the owner. */
    .footer-login {
        font-size: 0.75rem;
        color: inherit;
        opacity: 0.55;
        text-decoration: none;
    }

    .footer-login:hover,
    .footer-login:focus-visible {
        opacity: 1;
        text-decoration: underline;
    }

    .footer-brand {
        font-weight: 700;
        padding-inline: 0.15rem;
    }
</style>
