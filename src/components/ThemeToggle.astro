---
import { getUi } from '../i18n/ui';

const t = getUi(Astro.currentLocale);
---

<button type='button' class='theme-toggle' data-theme-state='light' aria-label={t.themeLabel}>
    <svg class='theme-icon icon-light' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
        <circle cx='12' cy='12' r='4' />
        <path d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41' />
    </svg>
    <svg class='theme-icon icon-dark' width='24' height='24' viewBox='0 0 24 24' fill='currentColor' stroke='none' aria-hidden='true'>
        <path d='M20 14.5a8.5 8.5 0 01-11-11 8.5 8.5 0 1011 11z' />
    </svg>
    <span class='theme-toggle-state'>{t.themeDark}</span>
</button>

<script is:inline define:vars={{ light: t.themeLight, dark: t.themeDark }}>
    // This component can render more than once on a page (a desktop copy and
    // a mobile-menu copy), so wiring runs exactly once, after every instance
    // has parsed, and keeps every button in sync with the same state. Every
    // instance's labels are identical (same locale), so overwriting this on
    // each run is harmless.
    window.__aolarThemeLabels = { light, dark };

    if (!window.__aolarThemeWired) {
        window.__aolarThemeWired = true;
        document.addEventListener('DOMContentLoaded', () => {
            const STORAGE_KEY = 'aolar-theme';
            const labels = window.__aolarThemeLabels;
            const buttons = Array.from(document.querySelectorAll('.theme-toggle'));
            if (buttons.length === 0) return;

            const media = window.matchMedia('(prefers-color-scheme: dark)');

            // System preference is only ever the *default*, on first load with
            // no explicit choice - light/dark are the only two things a click
            // can produce from here on.
            function resolvedTheme() {
                const stored = localStorage.getItem(STORAGE_KEY);
                if (stored === 'light' || stored === 'dark') return stored;
                return media.matches ? 'dark' : 'light';
            }

            // The button names the theme a click will switch TO, not the one
            // that's active now - e.g. while dark is active, it reads
            // "Light" (the destination), which is the more intuitive label.
            function displayLabel(theme) {
                return theme === 'light' ? labels.dark : labels.light;
            }

            function updateButtons(theme) {
                buttons.forEach((button) => {
                    button.dataset.themeState = theme;
                    const label = button.querySelector('.theme-toggle-state');
                    if (label) label.textContent = displayLabel(theme);
                });
            }

            updateButtons(resolvedTheme());

            // Keep the button in sync if OS preference changes before the
            // visitor has ever made an explicit choice.
            media.addEventListener('change', () => {
                if (!localStorage.getItem(STORAGE_KEY)) {
                    updateButtons(resolvedTheme());
                }
            });

            buttons.forEach((button) => {
                button.addEventListener('click', () => {
                    const next = resolvedTheme() === 'dark' ? 'light' : 'dark';
                    localStorage.setItem(STORAGE_KEY, next);
                    document.documentElement.setAttribute('data-theme', next);
                    updateButtons(next);
                });
            });
        });
    }
</script>

<style>
    .theme-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        border: none;
        border-radius: 0.25rem;
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-size: 0.75rem;
        padding: 0.3rem 0.4rem;
        cursor: pointer;
    }

    .theme-toggle:hover,
    .theme-toggle:focus-visible {
        background-color: var(--ink);
        color: var(--surface);
    }

    .theme-icon {
        width: 0.9rem;
        height: 0.9rem;
        display: none;
        flex-shrink: 0;
    }

    .theme-toggle[data-theme-state='light'] .icon-light,
    .theme-toggle[data-theme-state='dark'] .icon-dark {
        display: block;
    }
</style>
