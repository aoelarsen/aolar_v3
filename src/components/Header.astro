---
import { getRelativeLocaleUrl } from 'astro:i18n';
import MainNav from './MainNav.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

export interface Props {
    path?: string;
}

const { path = '' } = Astro.props;
const locale = Astro.currentLocale === 'nb' ? 'nb' : 'en';
const homeHref = getRelativeLocaleUrl(locale, '');
---

<header class='site-header'>
    <div>
        <a href={homeHref} class='brand-link'>
            <h1 class='brand-title'>AOL<span class='brand-title-thin'>ar.no</span></h1>
            <p class='brand-subtitle'>AOLar Holding AS</p>
        </a>
    </div>
    <div class='header-actions'>
        <div class='utility-bar'>
            <ThemeToggle />
            <LanguageSwitcher path={path} />
        </div>
        <MainNav path={path} />
    </div>
</header>

<style>
    .site-header {
        padding: 1.25rem;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.75rem;
    }

    @media (min-width: 768px) {
        .site-header {
            padding: 1.75rem;
        }
    }

    @media (min-width: 1024px) {
        .site-header {
            padding: 2.5rem;
        }
    }

    .brand-link {
        text-decoration: none;
        color: inherit;
    }

    .brand-title {
        font-weight: 700;
        font-size: 1.5rem;
        margin: 0;
    }

    @media (min-width: 768px) {
        .brand-title {
            font-size: 1.875rem;
        }
    }

    .brand-title-thin {
        font-weight: 300;
        padding-left: 0.15rem;
    }

    .brand-subtitle {
        margin: 0.25rem 0 0;
    }

    .header-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.5rem;
    }

    /* Below 640px this moves into MainNav's mobile menu instead - see MainNav.astro. */
    .utility-bar {
        display: none;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    @media (min-width: 640px) {
        .utility-bar {
            display: flex;
            flex-wrap: wrap;
        }
    }
</style>
