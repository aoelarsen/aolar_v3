---
import { getRelativeLocaleUrl } from 'astro:i18n';
import MainNav from './MainNav.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import BrandEmblem from './BrandEmblem.astro';
import Wordmark from './Wordmark.astro';

export interface Props {
    path?: string;
}

const { path = '' } = Astro.props;
const locale = Astro.currentLocale === 'nb' ? 'nb' : 'en';
const homeHref = getRelativeLocaleUrl(locale, '');
---

<header class='site-header'>
    <div>
        <a href={homeHref} class='brand-link'>
            <BrandEmblem variant='small' class='brand-emblem' />
            <h1 class='brand-title'><Wordmark /></h1>
        </a>
    </div>
    <div class='header-actions'>
        <div class='utility-bar'>
            <ThemeToggle />
            <LanguageSwitcher path={path} />
        </div>
        <MainNav path={path} />
    </div>
</header>

<style>
    .site-header {
        padding: 1.25rem;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.75rem;
    }

    @media (min-width: 768px) {
        .site-header {
            padding: 1.75rem;
        }
    }

    @media (min-width: 1024px) {
        .site-header {
            padding: 2.5rem;
        }
    }

    .brand-link {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        text-decoration: none;
        color: inherit;
    }

    .brand-emblem {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
    }

    .brand-title {
        font-size: 1rem;
        margin: 0;
    }

    .header-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.5rem;
    }

    /* Below 640px this moves into MainNav's mobile menu instead - see MainNav.astro. */
    .utility-bar {
        display: none;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    @media (min-width: 640px) {
        .utility-bar {
            display: flex;
            flex-wrap: wrap;
        }
    }
</style>
