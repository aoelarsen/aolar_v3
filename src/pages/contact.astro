---
import Layout from '../layouts/Layout.astro';
---

<Layout title='Contact AOLar.no'>
    <main class='page contact-page'>
        <div class='contact-heading'>
            <h2>You found me!</h2>
            <p class='tagline'>It's ok to say hi</p>
        </div>
        <p class='body-text'>
            If you serch for my name, I'll probably show up in a few places on the internet. Though
            the easies way to reach me is to just drop me a message here
        </p>
        <form class='contact-form' data-netlify='true' netlify-honeypot='bot-field' method='POST' id='contact-form'>
            <p class='honeypot'>
                <label>
                    Don't fill this out if you're human: <input name='bot-field' />
                </label>
            </p>
            <div class='field-row'>
                <label class='field'>
                    Name
                    <input required name='name' type='text' placeholder='Name' />
                </label>
                <label class='field'>
                    E-mail
                    <input name='email' required type='email' placeholder='something@other.com' />
                </label>
            </div>
            <label class='field'>
                Message
                <textarea
                    name='message'
                    required
                    placeholder='Say hi and let me know what is on your mind'
                    rows='10'></textarea>
            </label>
            <input name='submit' type='submit' value='Send message' class='submit-button' />
        </form>
        <script is:inline>
            document.getElementById('contact-form').addEventListener('submit', (e) => e.preventDefault);
        </script>
    </main>
</Layout>

<style>
    .page {
        display: grid;
        min-height: 50vh;
        gap: 1rem;
        place-content: center;
        padding: 0.5rem 0.5rem 1.5rem;
        max-width: 42rem;
        margin-inline: auto;
    }

    .contact-heading {
        display: flex;
        flex-wrap: wrap;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
    }

    @media (min-width: 768px) {
        .contact-heading {
            flex-direction: row;
            padding: 0.5rem 0;
        }
    }

    .contact-heading h2 {
        align-self: baseline;
        font-weight: 600;
        font-size: 1.25rem;
        margin: 0;
    }

    @media (min-width: 768px) {
        .contact-heading h2 {
            font-size: 2.25rem;
        }
    }

    .tagline {
        align-self: baseline;
        font-weight: 600;
        margin: 0;
    }

    @media (min-width: 768px) {
        .tagline {
            font-size: 1.5rem;
        }
    }

    .body-text {
        padding: 1rem;
        margin: 0;
    }

    .contact-form {
        display: grid;
        gap: 0.5rem;
        padding: 1rem 0.75rem;
    }

    @media (min-width: 768px) {
        .contact-form {
            padding: 1rem;
        }
    }

    .honeypot {
        display: none;
    }

    .field {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .field-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding-block: 0.5rem;
    }

    input,
    textarea {
        padding: 0.5rem;
        border-radius: 0.125rem;
        color: var(--color-primary);
        border: 1px solid #d1d5db;
        font: inherit;
    }

    input:invalid,
    textarea:invalid {
        border-color: #f43f5e;
    }

    input:valid,
    textarea:valid {
        border-color: #16a34a;
    }

    .submit-button {
        padding-block: 0.5rem;
        border-radius: 0.125rem;
        background-color: #15803d;
        color: var(--color-secondary);
        cursor: pointer;
        border: none;
    }

    .submit-button:hover {
        background-color: #14532d;
    }

    @media (min-width: 768px) {
        .submit-button {
            width: 50%;
            justify-self: end;
        }
    }
</style>
