---
import Layout from '../layouts/Layout.astro';
import { getUi } from '../i18n/ui';
import '../styles/pages/contact.css';

const t = getUi(Astro.currentLocale);
const contact = t.pages.contact;
---

<Layout title={contact.title} path='contact'>
    <main class='page contact-page' id='main-content'>
        <div class='contact-heading'>
            <h2>{contact.heading}</h2>
            <p class='tagline'>{contact.tagline}</p>
        </div>
        <p class='body-text'>{contact.bodyText}</p>
        <form
            class='contact-form'
            name='contact'
            data-netlify='true'
            netlify-honeypot='bot-field'
            method='POST'
            id='contact-form'
        >
            <input type='hidden' name='form-name' value='contact' />
            <p class='honeypot'>
                <label>
                    {contact.honeypotLabel}<input name='bot-field' />
                </label>
            </p>
            <div class='field-row'>
                <label class='field'>
                    {contact.nameLabel}
                    <input required name='name' type='text' autocomplete='name' placeholder={contact.namePlaceholder} />
                </label>
                <label class='field'>
                    {contact.emailLabel}
                    <input
                        name='email'
                        required
                        type='email'
                        autocomplete='email'
                        placeholder={contact.emailPlaceholder}
                    />
                </label>
            </div>
            <label class='field'>
                {contact.messageLabel}
                <textarea name='message' required placeholder={contact.messagePlaceholder} rows='10'
                ></textarea>
            </label>
            <input name='submit' type='submit' value={contact.submitLabel} class='submit-button' />
        </form>
    </main>
</Layout>
