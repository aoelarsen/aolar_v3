---
import Layout from '../layouts/Layout.astro';
---

<Layout title='About AOLar.no'>
    <main class='page about-page'>
        <h2 class='page-title'>About AOLar.no</h2>
        <p class='lead'>Aolar.no is a webspace for exploration, tinkering and testing new stuff.</p>
        <p class='body-text'>
            Anders Øksendal Larsen is me... a dude interested in bicycles, frontend-develpment, Lego
            among other things. Current occupation; bicycle mechanic, ski-technician and "him with
            the beard" for <a class='link' href='https://sport1.no/butikker/sport1royken/'
                >Sport1 Røyken</a
            >
        </p>
        <section class='info-block'>
            <h3>This site is:</h3>
            <p>
                - created with <a class='link' href='https://astro.build'>Astro</a>
            </p>
            <div class='deploy-status'>
                <p>
                    - hosted with <a href='https://netlify.com' class='link'>Netlify</a>
                </p><a href='https://app.netlify.com/sites/aolar/deploys' class='deploy-status-link'
                ></a>
                &rarr; <img
                    class='deploy-badge'
                    alt='netlify status badge'
                    src='https://api.netlify.com/api/v1/badges/4ce45616-d7c6-4d16-bd5c-2eb5c9a5f300/deploy-status'
                />
            </div>
            <p>
                - now also with help from <a class='link' href='https://claude.com/claude-code'
                    >Claude Code</a
                >
            </p>
        </section>
        <section class='info-block'>
            <h3>Things I work on:</h3>
            <p>Can be found in the workshop at Sport1 Røyken</p>
            <p>&hellip; or on github:</p>

            <a href='https://github.com/aoelarsen' class='github-link'>
                <svg
                    height='32'
                    aria-hidden='true'
                    viewBox='0 0 16 16'
                    version='1.1'
                    width='32'
                    data-view-component='true'
                    class='github-icon'
                >
                    <path
                        fill-rule='evenodd'
                        d='M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z'
                    ></path>
                </svg>
                aoelarsen
            </a>

            <p class='fine-print'>
                [&hellip; more will be inserted here as soon as I have the time to update]
            </p>
        </section>
    </main>
</Layout>

<style>
    .page {
        display: grid;
        min-height: 50vh;
        gap: 1rem;
        place-content: center;
        padding: 0.5rem;
        max-width: 42rem;
        margin-inline: auto;
    }

    .page-title {
        font-weight: 600;
        text-align: center;
        padding: 1rem 0;
        margin: 0;
    }

    @media (min-width: 768px) {
        .page-title {
            text-align: left;
            font-size: 2.25rem;
        }
    }

    .lead {
        font-size: 1.25rem;
        padding: 1rem;
        margin: 0;
    }

    .body-text {
        font-size: 1rem;
        padding: 1rem;
        margin: 0;
    }

    .info-block {
        padding: 1rem 0.75rem;
    }

    @media (min-width: 768px) {
        .info-block {
            padding: 1rem;
        }
    }

    .info-block h3 {
        font-weight: 600;
        margin: 0 0 0.5rem;
    }

    @media (min-width: 768px) {
        .info-block h3 {
            font-size: 1.125rem;
        }
    }

    .deploy-status {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
    }

    .deploy-status p {
        margin: 0;
    }

    .deploy-status-link {
        display: flex;
    }

    .deploy-badge {
        align-self: center;
    }

    .github-link {
        padding: 1.5rem 0;
        display: flex;
        gap: 1rem;
        justify-content: center;
        text-decoration: none;
        color: inherit;
    }

    @media (prefers-color-scheme: dark) {
        .github-icon {
            fill: var(--color-secondary);
        }
    }

    .fine-print {
        margin-top: 1rem;
        font-size: 0.75rem;
    }

    @media (min-width: 768px) {
        .fine-print {
            font-size: 0.875rem;
        }
    }
</style>
