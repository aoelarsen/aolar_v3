---
import Layout from '../../layouts/Layout.astro';
import HoldingLogo from '../../components/HoldingLogo';
import '../../styles/pages/index.css';
---

<Layout title='Velkommen til AOLar.no' path=''>
    <main class='home-main' id='main-content'>
        <section class='home-intro'>
            <h2><HoldingLogo client:visible /></h2>
            <noscript>
                <style>
                    .holding-logo .draw {
                        stroke-dashoffset: 0%;
                    }
                </style>
            </noscript>
            <h3>AOLar Holding AS</h3>
        </section>
        <figure class='home-quote'>
            <blockquote>
                <p>Jeg anser meg selv som en problemløser, uansett yrke.</p>
            </blockquote>
        </figure>
    </main>
</Layout>
