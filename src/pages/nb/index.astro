---
import Layout from '../../layouts/Layout.astro';
import HoldingLogo from '../../components/HoldingLogo';
import { getUi, companyName } from '../../i18n/ui';
import '../../styles/pages/index.css';

const t = getUi(Astro.currentLocale);
---

<Layout title={t.pages.home.title} path=''>
    <main class='home-main' id='main-content'>
        <section class='home-intro'>
            <h2><HoldingLogo client:visible /></h2>
            <noscript>
                <style>
                    .holding-logo .draw {
                        stroke-dashoffset: 0%;
                    }
                </style>
            </noscript>
            <h3>{companyName}</h3>
        </section>
        <figure class='home-quote'>
            <blockquote>
                <p>{t.pages.home.quote}</p>
            </blockquote>
        </figure>
    </main>
</Layout>
