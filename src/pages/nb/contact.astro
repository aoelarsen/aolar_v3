---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/contact.css';
---

<Layout title='Kontakt AOLar.no' path='contact'>
    <main class='page contact-page' id='main-content'>
        <div class='contact-heading'>
            <h2>Du fant meg!</h2>
            <p class='tagline'>Det er lov å si hei</p>
        </div>
        <p class='body-text'>
            Hvis du søker etter navnet mitt, dukker jeg nok opp noen steder på internett. Men den
            enkleste måten å nå meg på er å bare legge igjen en melding her
        </p>
        <form
            class='contact-form'
            name='contact'
            data-netlify='true'
            netlify-honeypot='bot-field'
            method='POST'
            id='contact-form'
        >
            <input type='hidden' name='form-name' value='contact' />
            <p class='honeypot'>
                <label>
                    Ikke fyll ut dette feltet hvis du er et menneske: <input name='bot-field' />
                </label>
            </p>
            <div class='field-row'>
                <label class='field'>
                    Navn
                    <input required name='name' type='text' autocomplete='name' placeholder='Navn' />
                </label>
                <label class='field'>
                    E-post
                    <input
                        name='email'
                        required
                        type='email'
                        autocomplete='email'
                        placeholder='noe@annet.com'
                    />
                </label>
            </div>
            <label class='field'>
                Melding
                <textarea
                    name='message'
                    required
                    placeholder='Si hei og fortell meg hva du tenker på'
                    rows='10'></textarea>
            </label>
            <input name='submit' type='submit' value='Send melding' class='submit-button' />
        </form>
        <script is:inline>
            document.getElementById('contact-form').addEventListener('submit', (e) => e.preventDefault);
        </script>
    </main>
</Layout>
