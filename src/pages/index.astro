---
import Layout from '../layouts/Layout.astro';
import BrandEmblem from '../components/BrandEmblem.astro';
import Wordmark from '../components/Wordmark.astro';
import { getUi } from '../i18n/ui';
import '../styles/pages/index.css';

const t = getUi(Astro.currentLocale);
---

<Layout title={t.pages.home.title} path=''>
    <main class='home-main' id='main-content'>
        <section class='home-intro'>
            <h2 class='home-logo'>
                <BrandEmblem class='home-emblem' />
                <Wordmark class='home-wordmark' />
            </h2>
        </section>
        <figure class='home-quote'>
            <blockquote>
                <p>{t.pages.home.quote}</p>
            </blockquote>
        </figure>
    </main>
</Layout>
