---
import Layout from '../layouts/Layout.astro';
---

<Layout title='Welcome to AOLar.no'>
    <main class='home-main'>
        <section class='home-intro'>
            <h2>Frontend developer</h2>
            <p>&hellip; working as a bicycle&nbsp;mechanic</p>
        </section>
        <figure class='home-quote'>
            <blockquote>
                <p>I consider myself a problem solver regardless of occupation.</p>
            </blockquote>
        </figure>
    </main>
</Layout>

<style>
    .home-main {
        display: grid;
        grid-template-columns: 1fr;
        min-height: 50vh;
    }

    .home-intro {
        margin-inline: auto;
        padding: 1rem;
        align-self: center;
        display: grid;
        justify-items: center;
        align-content: center;
        width: 91.6667%;
        text-align: center;
    }

    @media (min-width: 768px) {
        .home-intro {
            text-align: right;
        }
    }

    .home-intro h2 {
        font-weight: 700;
        font-size: 3rem;
        margin: 0;
    }

    @media (min-width: 768px) {
        .home-intro h2 {
            font-size: 4.5rem;
        }
    }

    .home-intro p {
        font-size: 1.25rem;
        margin: 0;
    }

    @media (min-width: 768px) {
        .home-intro p {
            font-size: 1.5rem;
        }
    }

    .home-quote {
        padding: 1rem;
        width: 91.6667%;
        align-self: center;
        margin-inline: auto;
    }

    @media (min-width: 1024px) {
        .home-quote {
            width: 100%;
        }
    }

    .home-quote p {
        text-align: center;
        font-size: 1.5rem;
        padding: 1rem;
        margin: 0;
    }

    @media (min-width: 768px) {
        .home-quote p {
            text-align: right;
            font-size: 1.875rem;
        }
    }

    @media (min-width: 1024px) {
        .home-quote p {
            text-align: center;
        }
    }
</style>
